# Kopiera till .env:  copy .env.example .env
#
# Neon (produktion / Vercel) — två URL:er:
# DATABASE_URL = pooler-URL från Neon (hostname innehåller "-pooler")
#   Lägg till: ?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30
# DIRECT_URL = direkt-URL utan "-pooler" i hostname (samma användare/lösenord/databas)
#   Lägg till: ?sslmode=require&connect_timeout=30
#
# Om DIRECT_URL saknas lokalt kan du härleda den från DATABASE_URL:
#   ep-xxx-pooler.region.aws.neon.tech  →  ep-xxx.region.aws.neon.tech
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
JWT_SECRET="byt-till-en-säker-hemlighet-i-produktion"
